# Blokada katalogów z danymi i wynikami
data/raw/*
data/external/*
data/interim/*
submissions/*

!data/raw/.gitkeep
!data/external/.gitkeep
!data/interim/.gitkeep
!submissions/.gitkeep

# Blokada plików danych, wideo i modeli po rozszerzeniach
