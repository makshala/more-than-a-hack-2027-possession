*.csv
*.xml
*.json
*.jsonl
*.h5
*.pkl
*.pickle
*.mp4
*.avi
*.mov
*.mkv
*.gif
*.zip
*.tar
*.tar.gz

# Blokada notatników Jupyter (chroni przed zapisanymi wykresami z meczów)
*.ipynb
.ipynb_checkpoints/

# Środowisko Python i system
__pycache__/
*.py[cod]
.venv/
venv/
.env
.idea/
.vscode/
.DS_Store
